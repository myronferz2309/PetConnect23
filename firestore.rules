rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // Users can read profiles, but only create or update their own document
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // PETS COLLECTION
    // Anyone can browse adoptable pets.
    // Initial system seed pets can be seeded, and authenticated users can list pets with their own ownerId.
    // Only the pet owner can update or delete their listed pet.
    match /pets/{petId} {
      allow read: if true;
      allow create: if request.resource.data.ownerId == 'system-shelter-partner' ||
                       (isAuthenticated() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        // Allow status updates during adoption workflows if user is pet owner
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && resource.data.ownerId == request.auth.uid)
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ADOPTION APPLICATIONS COLLECTION
    // Only the applicant and the pet owner can read the application.
    // Authenticated users can create an application for a pet (cannot apply to own pet).
    // Only the pet owner can accept or decline (update status) an application.
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.petOwnerId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.applicantId == request.auth.uid &&
        request.resource.data.petOwnerId != request.auth.uid;
      allow update: if isAuthenticated() && (
        // Only pet owner can accept/reject application status
        resource.data.petOwnerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if false;
    }
  }
}
